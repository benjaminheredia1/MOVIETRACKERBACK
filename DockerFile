# Etapa 1: Build
FROM golang:1.25-alpine AS build

WORKDIR /app

# Copiar dependencias primero para aprovechar cache de Docker
COPY go.mod go.sum ./
RUN go mod download

# Copiar el código fuente
COPY . .

# Compilar el binario
RUN CGO_ENABLED=0 GOOS=linux go build -o movietracker ./cmd/main.go

# Etapa 2: Imagen final mínima
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copiar el binario compilado
COPY --from=build /app/movietracker .

# Copiar migraciones
COPY --from=build /app/db ./db

EXPOSE 8080

CMD ["./movietracker"]
